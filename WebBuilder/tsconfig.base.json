{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@webforge/schema": ["./packages/schema/src/index.ts"],
      "@webforge/schema/*": ["./packages/schema/src/*"],
      "@webforge/design-system": ["./packages/design-system/src/index.ts"],
      "@webforge/design-system/*": ["./packages/design-system/src/*"],
      "@webforge/editor-core": ["./packages/editor-core/src/index.ts"],
      "@webforge/editor-core/*": ["./packages/editor-core/src/*"],
      "@webforge/block-registry": ["./packages/block-registry/src/index.ts"],
      "@webforge/block-registry/*": ["./packages/block-registry/src/*"],
      "@webforge/template-registry": ["./packages/template-registry/src/index.ts"],
      "@webforge/template-registry/*": ["./packages/template-registry/src/*"],
      "@webforge/codegen": ["./packages/codegen/src/index.ts"],
      "@webforge/codegen/*": ["./packages/codegen/src/*"],
      "@webforge/backend-adapters": ["./packages/backend-adapters/src/index.ts"],
      "@webforge/backend-adapters/*": ["./packages/backend-adapters/src/*"],
      "@webforge/integrations": ["./packages/integrations/src/index.ts"],
      "@webforge/integrations/*": ["./packages/integrations/src/*"],
      "@webforge/testing": ["./packages/testing/src/index.ts"],
      "@webforge/testing/*": ["./packages/testing/src/*"]
    }
  }
}
