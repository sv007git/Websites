# ShareIt Environment Configuration

# Base path for deployment (e.g. /ShareIt/ for GitHub Pages, / for custom domain or local dev)
VITE_BASE_PATH=/ShareIt/

# WebSocket Signaling Server URL
# For local dev: ws://localhost:8080
# For Cloudflare Workers Durable Object: wss://your-shareit-signaling.your-subdomain.workers.dev
# Leave empty to use local broadcast-fallback or configurable in UI
VITE_SIGNALING_SERVER=ws://localhost:8080

# STUN Servers (comma-separated)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Optional TURN Servers (for restrictive firewalls / symmetric NAT)
# Never commit private credentials into public git repos!
VITE_TURN_SERVERS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional Default Room Prefix
VITE_ROOM_PREFIX=share-
