  "license": "MIT",
  "homepage": "https://sv007git.github.io/ShareIt/",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "mqtt": "^5.16.1",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
