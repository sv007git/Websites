{
  "name": "shareit",
  "version": "1.0.0",
  "description": "ShareIt - Real-Time Screen Sharing, Video Conferencing & Audio Communication Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
